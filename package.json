{
  "name": "telegram-poland-life-guide-bot",
  "version": "1.0.0",
  "description": "Telegram guide for living in Poland: rules, fines, public places and everyday situations in multiple languages.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec node --experimental-sqlite --require ts-node/register src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
